<% layout("/layouts/boilerplate") -%>
<body>
  <div class="d-flex align-items-center mb-2">
    <h3>All Listings</h3>
    <div class="tax-toggle ms-auto mt-1 d-flex align-items-center">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
      </div>
    </div>
  </div>
  
  <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1">
    <% for(let listing of allListings) { %>
      <a href="/listings/<%= listing._id%>" class="listing-links">
        <div class="card listing-card cols">
          <img src="<%=listing.image.url%>" class="card-img-top" alt="Hotel image" style="height: 20rem;">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %> <br></b>
              &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
              <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
</body>
